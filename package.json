{
  "name": "@kubohiroya/turbowarp-camera-calibration-app",
  "version": "0.7.2",
  "private": true,
  "type": "module",
  "description": "市松模様の表示と撮影を1つのアプリで行い、カメラのレンズ校正プロファイルを作成して書き出すアプリです。",
  "license": "MPL-2.0",
  "author": {
    "name": "Hiroya Kubo",
    "email": "hiroya@cuc.ac.jp",
    "url": "https://github.com/kubohiroya"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kubohiroya/turbowarp-camera-calibration-app.git"
  },
  "packageManager": "pnpm@11.28.8",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "pnpm run build:sb3 && vite build",
    "build:sb3": "node scripts/build-sb3.ts",
    "lint": "eslint src scripts config tests vite.config.ts",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm run lint && pnpm run format && pnpm run typecheck && pnpm run test && pnpm run build",
    "template:init": "node scripts/init-app.ts",
    "profile:read": "node scripts/read-profile.ts"
  },
  "dependencies": {
    "@kubohiroya/turbowarp-app-shell": "^0.6.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@kubohiroya/sb3-toolchain": "^0.28.1",
    "@kubohiroya/turbowarp-camera-calibration": "^0.21.2",
    "@kubohiroya/turbowarp-camera-source": "^0.25.1",
    "@kubohiroya/turbowarp-qr-display": "^0.8.1",
    "@types/node": "24.13.3",
    "eslint": "9.39.5",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.66.0",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  },
  "homepage": "https://github.com/kubohiroya/turbowarp-camera-calibration-app#readme",
  "bugs": {
    "url": "https://github.com/kubohiroya/turbowarp-camera-calibration-app/issues"
  }
}
